#!/bin/bash
set -euo pipefail

# --- FORMATTING ---
BOLD_BLUE='\033[1;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# --- CONFIGURATION TOGGLES ---
DRY_RUN=false        # Set to true to simulate without changing files
SHUTDOWN_AFTER=false # Set to true to shut down PC when finished

# --- PATHS ---
# Update these paths according to your actual source and external SSD mount point
SOURCE="/run/media/aritro/f522493b-003a-404d-a839-3e0925c674b6/Aritro/StagYY/archive_runs/euler/i3D_01/archive/"
SSD_DEST="/run/media/aritro/Extreme SSD/archive_runs/euler/i3D_01/archive/" # Replace SSD_NAME with actual mount point

# --- LOGGING SETUP ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="$SCRIPT_DIR/backup_log"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/local_backup_$(date +%Y%m%d_%H%M%S).log"

# --- HELPER FUNCTIONS ---
log_step() {
    echo -e "${BOLD_BLUE}==>${NC} ${BOLD_BLUE}$1${NC}"
}

log_success() {
    echo -e "${GREEN}[OK] $1${NC}"
}

log_skip() {
    echo -e "${YELLOW}[SKIP] $1${NC}"
}

log_error() {
    echo -e "${RED}[ERROR] $1${NC}"
}

# --- PRE-FLIGHT CHECKS ---
if [ ! -d "$SSD_DEST" ]; then
    log_error "Destination directory $SSD_DEST does not exist or SSD is not mounted!"
    exit 1
fi

if [ "$SHUTDOWN_AFTER" = true ]; then
    log_step "Shutdown enabled. Requesting sudo access now to avoid later prompts..."
    sudo -v
fi

# Open FD 3 to process all text (stripping colors) into the log file
exec 3> >(sed 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$LOG_FILE")

# Redirect standard output to BOTH the terminal and the log file
exec > >(tee -i >(cat >&3))

# Redirect standard error ONLY to the log file (hides system warnings from terminal)
exec 2>&3

echo -e "${BOLD_BLUE}Starting Local Backup Process...${NC}"
echo -e "Log file: $LOG_FILE\n"

# Prepare rsync options
# Disable owner, group, and permissions to avoid errors on external filesystems like exFAT/NTFS
RSYNC_LOG="$LOG_DIR/local_rsync_details_$(date +%Y%m%d_%H%M%S).log"
RSYNC_OPTS=(-ah --info=progress2 --log-file="$RSYNC_LOG" --no-owner --no-group --no-perms)
if [ "$DRY_RUN" = true ]; then
    RSYNC_OPTS+=("--dry-run")
    log_step "DRY RUN MODE: No files will be modified."
fi

# --- MAIN EXECUTION ---
log_step "Syncing files to external SSD..."

# Disable set -e temporarily to handle rsync exit code manually
set +e
rsync "${RSYNC_OPTS[@]}" "$SOURCE" "$SSD_DEST"
RSYNC_EXIT_CODE=$?
set -e

echo ""
if [ $RSYNC_EXIT_CODE -eq 0 ]; then
    log_success "Local backup completed successfully at $(date)."
else
    log_error "Local backup FAILED at $(date)."
    case $RSYNC_EXIT_CODE in
        1) log_error "Syntax or usage error." ;;
        2) log_error "Protocol incompatibility." ;;
        3) log_error "Errors selecting input/output files, dirs." ;;
        10) log_error "Error in socket I/O." ;;
        11) log_error "Error in file I/O." ;;
        12) log_error "Error in rsync protocol data stream." ;;
        23) log_error "Partial transfer due to error." ;;
        24) log_error "Partial transfer due to vanished source files." ;;
        *) log_error "rsync failed with exit code $RSYNC_EXIT_CODE." ;;
    esac
    exit 1
fi

# Shutdown (Toggleable)
if [ "$SHUTDOWN_AFTER" = true ] && [ "$DRY_RUN" = false ]; then
    log_step "Shutdown toggle is ON. System will shut down in 60 seconds."
    sudo shutdown -h +1
elif [ "$SHUTDOWN_AFTER" = true ] && [ "$DRY_RUN" = true ]; then
    log_skip "Dry run enabled. Skipping shutdown."
fi
