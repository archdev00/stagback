#!/bin/bash
set -euo pipefail

# --- FORMATTING ---
BOLD_BLUE='\033[1;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# --- CONFIGURATION TOGGLES ---
DRY_RUN=false        # Set to true to simulate without changing files
RUN_MIRROR=false      # Set to true to run mirror backup, false to skip
SHUTDOWN_AFTER=false # Set to true to shut down PC when finished
DELETE_OLD_TRACERS=true # Set to true to delete older tracers before backup
TRACERS_TO_KEEP=40       # Number of final tracers to keep
DELETE_OLD_OUTPUTS=false # Set to true to delete ALL old output files (excluding tracers, .dat, .h5, .bin) AFTER backup
OUTPUTS_TO_KEEP=50       # Number of final timesteps to keep for all output files

# --- PATHS ---
SERVER="bt732647@lipwig.hpc.uni-bayreuth.de:/scratch/bt732647/hdf/"
ARCHIVE="/home/aritro/Documents/Academia/PhD/StagYY/scripts/backup/archive/"
MIRROR="/home/aritro/Documents/Academia/PhD/StagYY/scripts/backup/mirror"
SSH_KEY="/home/aritro/.ssh/lipwig_key"

# --- LOGGING SETUP ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="$SCRIPT_DIR/backup_log"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/backup_$(date +%Y%m%d_%H%M%S).log"





# ==========================================
#       USER EDITS NOTHING BELOW
# ==========================================

MIN_TRACERS_TO_KEEP=60   # Safety limit; change at your own risk!
MIN_OUTPUTS_TO_KEEP=40   # Safety limit for output files

SERVER_HOST="${SERVER%%:*}"
SERVER_PATH="${SERVER#*:}"

# --- HELPER FUNCTIONS ---
log_step() {
    echo -e "${BOLD_BLUE}==>${NC} ${BOLD_BLUE}$1${NC}"
}

log_success() {
    echo -e "${GREEN}[OK] $1${NC}"
}

log_skip() {
    echo -e "${YELLOW}[SKIP] $1${NC}"
}

log_error() {
    echo -e "${RED}[ERROR] $1${NC}"
}

prompt_continue_backup() {
    local reason="${1:-A deletion step was hindered or cancelled.}"
    echo -n -e "${YELLOW}${reason} Continue with backup anyway? (y/N): ${NC}" > /dev/tty
    read cont_confirm < /dev/tty
    echo "User response (continue backup): $cont_confirm"
    if [[ $cont_confirm != [yY] && $cont_confirm != [yY][eE][sS] ]]; then
        log_error "Backup aborted by user."
        exit 1
    fi
}

# --- PRE-FLIGHT CHECKS ---


OUTPUTS_FILES_TO_DELETE=""
if [ "$DELETE_OLD_OUTPUTS" = true ]; then
    log_step "Pre-flight: Checking for old output files to delete..."
    if [ "$OUTPUTS_TO_KEEP" -lt "$MIN_OUTPUTS_TO_KEEP" ]; then
        echo -e "${YELLOW}======================================================${NC}"
        echo -e "${RED}SAFETY OVERRIDE: OUTPUTS_TO_KEEP is set to $OUTPUTS_TO_KEEP.${NC}"
        echo -e "A minimum history of output files is strongly recommended for analysis."
        echo -e "If the most recent files are corrupted, you will need older outputs."
        echo -e "To prevent accidental data loss, the script is overriding your setting."
        echo -e "${YELLOW}-> Automatically adjusting OUTPUTS_TO_KEEP to the safe minimum of $MIN_OUTPUTS_TO_KEEP...${NC}"
        echo -e "${YELLOW}======================================================${NC}"
        OUTPUTS_TO_KEEP=$MIN_OUTPUTS_TO_KEEP
    fi

    set +e
    ALL_OUTPUTS=$(ssh -i "$SSH_KEY" "$SERVER_HOST" "find \"${SERVER_PATH}+op\" -maxdepth 1 -type f -name '*[0-9][0-9][0-9][0-9][0-9]' ! -name '*tra[0-9]*' ! -name '*.dat' ! -name '*.h5' ! -name '*.bin'" 2>/dev/null)
    SSH_STATUS=$?
    set -e
    
    if [ $SSH_STATUS -ne 0 ]; then
         log_error "SSH check failed. Output deletion will be skipped."
         prompt_continue_backup "Output deletion was hindered."
    elif [ -z "$ALL_OUTPUTS" ]; then
         log_skip "No 5-digit output files found in ${SERVER_PATH}+op"
    else
         UNIQUE_STEPS=$(echo "$ALL_OUTPUTS" | sed -E 's/.*([0-9]{5})$/\1/' | sort -u)
         NUM_STEPS=$(echo "$UNIQUE_STEPS" | wc -l)
         if [ "$NUM_STEPS" -le "$OUTPUTS_TO_KEEP" ]; then
             log_skip "Found $NUM_STEPS total timesteps, which is <= $OUTPUTS_TO_KEEP. Nothing to delete."
         else
             NUM_STEPS_TO_DELETE=$((NUM_STEPS - OUTPUTS_TO_KEEP))
             STEPS_TO_DELETE=$(echo "$UNIQUE_STEPS" | head -n "$NUM_STEPS_TO_DELETE" || true)
             STEPS_PATTERN=$(echo "$STEPS_TO_DELETE" | paste -sd '|')
             OUTPUTS_FILES_TO_DELETE=$(echo "$ALL_OUTPUTS" | grep -E "(${STEPS_PATTERN})$" || true)
             
             if [ -n "$OUTPUTS_FILES_TO_DELETE" ]; then
                 NUM_FILES_TO_DELETE=$(echo "$OUTPUTS_FILES_TO_DELETE" | wc -l)
                 OLDEST_STEP=$(echo "$UNIQUE_STEPS" | head -n 1 || true)
                 NEWEST_DELETE_STEP=$(echo "$STEPS_TO_DELETE" | tail -n 1)
                 
                 STEPS_TO_KEEP=$(echo "$UNIQUE_STEPS" | tail -n "$OUTPUTS_TO_KEEP")
                 OLDEST_KEPT_STEP=$(echo "$STEPS_TO_KEEP" | head -n 1 || true)
                 NEWEST_KEPT_STEP=$(echo "$STEPS_TO_KEEP" | tail -n 1)
                 
                 echo -e "${YELLOW}======================================================${NC}"
                 echo -e "${YELLOW}PRE-FLIGHT WARNING: Output Deletion on SERVER Scheduled${NC}"
                 echo -e "Total unique timesteps found on SERVER: $NUM_STEPS"
                 echo -e "Target timesteps to keep on SERVER: $OUTPUTS_TO_KEEP (from $OLDEST_KEPT_STEP to $NEWEST_KEPT_STEP)"
                 echo -e "This will permanently delete exactly $NUM_FILES_TO_DELETE older output files from the SERVER (timesteps $OLDEST_STEP to $NEWEST_DELETE_STEP)."
                 echo -e "Note: This deletion will execute ONLY AFTER the backup completes successfully."
                 echo -e "${YELLOW}======================================================${NC}"
                 
                 if [ "$DRY_RUN" = true ]; then
                     : # Auto-authorized; proceed silently.
                 else
                     echo -n -e "Authorize this deletion to run after backup? (y/N): " > /dev/tty
                     read confirm < /dev/tty
                     if [[ $confirm != [yY] && $confirm != [yY][eE][sS] ]]; then
                         log_skip "Output deletion cancelled by user."
                         OUTPUTS_FILES_TO_DELETE=""
                         prompt_continue_backup "Output deletion was cancelled."
                     else
                         log_success "Deletion authorized."
                     fi
                 fi
             fi
         fi
    fi
fi
if [ "$SHUTDOWN_AFTER" = true ]; then
    log_step "Shutdown enabled. Requesting sudo access now to avoid later prompts..."
    sudo -v
    # Keep sudo timestamp alive in the background until the script exits
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

# Open FD 3 to process all text (stripping colors) into the log file
exec 3> >(sed 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$LOG_FILE")

# Redirect standard output to BOTH the terminal and the log file
exec > >(tee -i >(cat >&3))

# Redirect standard error ONLY to the log file (hides messy SSH/system warnings from terminal)
exec 2>&3

echo -e "${BOLD_BLUE}Starting Backup Process...${NC}"
echo -e "Log file: $LOG_FILE\n"

# Prepare rsync options
# --info=progress2 provides a total transfer progress summary.
RSYNC_LOG="$LOG_DIR/rsync_details_$(date +%Y%m%d_%H%M%S).log"
RSYNC_OPTS=(-ah --info=progress2 --log-file="$RSYNC_LOG" -e "ssh -i $SSH_KEY")
if [ "$DRY_RUN" = true ]; then
    RSYNC_OPTS+=("--dry-run")
    log_step "DRY RUN MODE: No files will be modified."
    log_success "DRY RUN MODE: Auto-authorizing deletion simulation."
fi

# --- TRACER CLEANUP ---
if [ "$DELETE_OLD_TRACERS" = true ]; then
    log_step "Step 0: Checking for old tracers to delete..."
    if [ "$TRACERS_TO_KEEP" -lt "$MIN_TRACERS_TO_KEEP" ]; then
        echo -e "${YELLOW}======================================================${NC}"
        echo -e "${RED}SAFETY OVERRIDE: TRACERS_TO_KEEP is set to $TRACERS_TO_KEEP.${NC}"
        echo -e "StagYY restarts require the final tracer. If the latest tracer is corrupted,"
        echo -e "you will need a history of older tracers to successfully restart the run."
        echo -e "To prevent accidental data loss, the script is overriding your setting."
        echo -e "${YELLOW}-> Automatically adjusting TRACERS_TO_KEEP to the safe minimum of $MIN_TRACERS_TO_KEEP...${NC}"
        echo -e "${YELLOW}======================================================${NC}"
        TRACERS_TO_KEEP=$MIN_TRACERS_TO_KEEP
    fi
    
    set +e
    TRACER_FILES=$(ssh -i "$SSH_KEY" "$SERVER_HOST" "find \"${SERVER_PATH}+op\" -maxdepth 1 -type f -name '*tra[0-9]*' | sort" 2>/dev/null)
    SSH_STATUS=$?
    set -e
    
    if [ $SSH_STATUS -ne 0 ]; then
        log_error "SSH connection or directory check failed. Skipping tracer deletion."
        prompt_continue_backup "Tracer deletion was hindered."
    else
        if [ -z "$TRACER_FILES" ]; then
            NUM_TRACERS=0
        else
            NUM_TRACERS=$(echo "$TRACER_FILES" | wc -l)
        fi

        if [ "$NUM_TRACERS" -eq 0 ]; then
            log_skip "No tracers found in ${SERVER_PATH}+op"
        elif [ "$NUM_TRACERS" -le "$TRACERS_TO_KEEP" ]; then
            log_skip "Found $NUM_TRACERS tracers, which is <= $TRACERS_TO_KEEP. Nothing to delete."
        else
            NUM_TO_DELETE=$((NUM_TRACERS - TRACERS_TO_KEEP))
            FILES_TO_DELETE=$(echo "$TRACER_FILES" | head -n "$NUM_TO_DELETE" || true)
            
            OLDEST_DELETE_TRACER=$(echo "$FILES_TO_DELETE" | head -n 1 | sed -E 's/.*([0-9]{5})$/\1/' || true)
            NEWEST_DELETE_TRACER=$(echo "$FILES_TO_DELETE" | tail -n 1 | sed -E 's/.*([0-9]{5})$/\1/')
            
            FILES_TO_KEEP=$(echo "$TRACER_FILES" | tail -n "$TRACERS_TO_KEEP")
            OLDEST_KEPT_TRACER=$(echo "$FILES_TO_KEEP" | head -n 1 | sed -E 's/.*([0-9]{5})$/\1/' || true)
            NEWEST_KEPT_TRACER=$(echo "$FILES_TO_KEEP" | tail -n 1 | sed -E 's/.*([0-9]{5})$/\1/')
            
            echo -e "${YELLOW}======================================================${NC}"
            echo -e "${YELLOW}WARNING: Tracer Deletion on SERVER Scheduled${NC}"
            echo -e "Total physical tracer files found on SERVER: $NUM_TRACERS"
            echo -e "Target physical files to keep on SERVER: $TRACERS_TO_KEEP (from $OLDEST_KEPT_TRACER to $NEWEST_KEPT_TRACER)"
            echo -e "This will permanently delete exactly $NUM_TO_DELETE older tracers from the SERVER (timesteps $OLDEST_DELETE_TRACER to $NEWEST_DELETE_TRACER)."
            echo -e "Note: This preserves exactly $TRACERS_TO_KEEP most recent files, regardless of numbering gaps."
            echo -e "${RED}Risk: If the latest tracers are corrupted, you might not have enough history to restart the run.${NC}"
            echo -e "${YELLOW}======================================================${NC}"
            
            if [ "$DRY_RUN" = true ]; then
                log_step "DRY RUN: Would delete $NUM_TO_DELETE tracers."
                echo "Would delete from: $(echo "$FILES_TO_DELETE" | head -n 1 || true) to $(echo "$FILES_TO_DELETE" | tail -n 1)"
            else
                sleep 0.5 # Wait for terminal output to flush before prompting
                echo -n -e "Are you sure you want to proceed with deletion? (y/N): " > /dev/tty
                read confirm < /dev/tty
                echo "User response: $confirm"
                
                if [[ $confirm == [yY] || $confirm == [yY][eE][sS] ]]; then
                    if [ -n "$FILES_TO_DELETE" ]; then
                        log_step "Deleting $NUM_TO_DELETE old tracers..."
                        echo "$FILES_TO_DELETE" | ssh -i "$SSH_KEY" "$SERVER_HOST" "xargs rm -f"
                        log_success "Old tracers deleted."
                    fi
                else
                    log_skip "Deletion cancelled by user."
                    prompt_continue_backup "Tracer deletion was cancelled."
                fi
            fi
        fi
    fi
    echo ""
fi

# --- MAIN EXECUTION ---
{
    # 1. Archive new binaries
    log_step "Step 1/4: Archiving new binaries..."
    rsync "${RSYNC_OPTS[@]}" --ignore-existing \
      --exclude='*.dat' \
      --exclude='*.h5' \
      --exclude='*.bin' \
      "$SERVER" "$ARCHIVE"

    # 2. Update .dat, .h5, and .bin files
    log_step "Step 2/4: Updating .dat, .h5, and .bin files in archive..."
    rsync "${RSYNC_OPTS[@]}" \
      --include='*/' \
      --include='*.dat' \
      --include='*.h5' \
      --include='*.bin' \
      --exclude='*' \
      "$SERVER" "$ARCHIVE"

    # 3. Mirror Backup (Toggleable)
    if [ "$RUN_MIRROR" = true ]; then
        log_step "Step 3/4: Creating mirror backup..."
        rsync "${RSYNC_OPTS[@]}" --delete \
          "$SERVER" "$MIRROR"
    else
        log_skip "Step 3/4: Skipping mirror backup as per toggle."
    fi

    # --- POST-BACKUP CLEANUP ---
    if [ -n "${OUTPUTS_FILES_TO_DELETE:-}" ]; then
        echo ""
        log_step "Step 4/4: Post-Backup Cleanup: Deleting authorized old output files from server..."
        if [ "$DRY_RUN" = true ]; then
            log_skip "DRY RUN: Would delete $(echo "$OUTPUTS_FILES_TO_DELETE" | wc -l) old output files."
        else
            echo "$OUTPUTS_FILES_TO_DELETE" | ssh -i "$SSH_KEY" "$SERVER_HOST" "xargs rm -f"
            log_success "Old output files deleted successfully."
        fi
    fi

    echo ""
    log_success "Backup completed successfully at $(date)."

} || {
    echo ""
    log_error "Backup FAILED at $(date)."
    exit 1
}

# 4. Shutdown (Toggleable)
if [ "$SHUTDOWN_AFTER" = true ] && [ "$DRY_RUN" = false ]; then
    log_step "Shutdown toggle is ON. System will shut down in 60 seconds."
    sudo shutdown -h +1
elif [ "$SHUTDOWN_AFTER" = true ] && [ "$DRY_RUN" = true ]; then
    log_skip "Dry run enabled. Skipping shutdown."
fi
