#!/bin/bash
set -euo pipefail

# --- FORMATTING ---
BOLD_BLUE='\033[1;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# --- CONFIGURATION TOGGLES ---
DRY_RUN=true           # Set to true to simulate without changing files
SHUTDOWN_AFTER=false    # Set to true to shut down PC when finished

# --- PATHS ---
# Using the paths from your old upload script
LOCAL_DATA="/run/media/aritro/f522493b-003a-404d-a839-3e0925c674b6/Aritro/StagYY/archive_runs/euler/i3D_02/mirror/"
REMOTE_SERVER="achattopadhy@euler.ethz.ch:/cluster/scratch/achattopadhy/i3D_02/"
SSH_KEY="/home/aritro/.ssh/euler_key"

# --- LOGGING SETUP ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="$SCRIPT_DIR/upload_log"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/upload_$(date +%Y%m%d_%H%M%S).log"


# ==========================================
#       USER EDITS NOTHING BELOW
# ==========================================

# --- HELPER FUNCTIONS ---
log_step() {
    echo -e "${BOLD_BLUE}==>${NC} ${BOLD_BLUE}$1${NC}"
}

log_success() {
    echo -e "${GREEN}[OK] $1${NC}"
}

log_skip() {
    echo -e "${YELLOW}[SKIP] $1${NC}"
}

log_error() {
    echo -e "${RED}[ERROR] $1${NC}"
}

if [ "$SHUTDOWN_AFTER" = true ]; then
    log_step "Shutdown enabled. Requesting sudo access now to avoid later prompts..."
    sudo -v
    # Keep sudo timestamp alive in the background until the script exits
    while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

# Open FD 3 to process all text (stripping colors) into the log file
exec 3> >(sed 's/\x1B\[[0-9;]*[a-zA-Z]//g' > "$LOG_FILE")

# Redirect standard output to BOTH the terminal and the log file
exec > >(tee -i >(cat >&3))

# Redirect standard error ONLY to the log file (hides messy SSH/system warnings from terminal)
exec 2>&3

echo -e "${BOLD_BLUE}Starting Upload Process...${NC}"
echo -e "Log file: $LOG_FILE\n"

# Prepare rsync options
RSYNC_LOG="$LOG_DIR/rsync_upload_details_$(date +%Y%m%d_%H%M%S).log"
# -a: archive mode, -h: human-readable, -u: update (skip files that are newer on receiver)
# Removed -v to prevent flooding the terminal with filenames
RSYNC_OPTS=(-ahu --info=progress2 --log-file="$RSYNC_LOG" -e "ssh -i $SSH_KEY")
if [ "$DRY_RUN" = true ]; then
    RSYNC_OPTS+=("--dry-run")
    log_step "DRY RUN MODE: No files will be modified."
fi

# --- MAIN EXECUTION ---
{
    if [ "$DRY_RUN" = true ]; then
        log_step "Simulating upload: calculating which files will be uploaded..."
    else
        log_step "Uploading files from local to server..."
    fi

    rsync "${RSYNC_OPTS[@]}" "$LOCAL_DATA" "$REMOTE_SERVER"

    echo ""
    if [ "$DRY_RUN" = true ]; then
        log_success "Dry run performed successfully at $(date)."
    else
        log_success "Upload completed successfully at $(date)."
    fi

} || {
    echo ""
    log_error "Upload FAILED at $(date)."
    exit 1
}

# Shutdown (Toggleable)
if [ "$SHUTDOWN_AFTER" = true ] && [ "$DRY_RUN" = false ]; then
    log_step "Shutdown toggle is ON. System will shut down in 60 seconds."
    sudo shutdown -h +1
elif [ "$SHUTDOWN_AFTER" = true ] && [ "$DRY_RUN" = true ]; then
    log_skip "Dry run enabled. Skipping shutdown."
fi
